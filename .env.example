# Copy to .env and fill in. Never commit .env.

# Local: docker compose Postgres. Deployed: Render's external connection string.
DATABASE_URL=postgresql://monitor:monitor@localhost:5432/monitor

# The simulator runs locally on 8001 and on Render as a second free web service.
SIMULATOR_BASE_URL=http://localhost:8001

# Admin keys. With the simulator, any non-empty string passes its auth check.
# Real keys live only in the deployed environment (GitHub Actions secrets).
ANTHROPIC_ADMIN_KEY=
OPENAI_ADMIN_KEY=

# Alerting. Leave empty to use the console sink.
SLACK_WEBHOOK_URL=

# Dead-man's switch. The scheduler pings this URL at the end of every healthy cycle.
HEALTHCHECKS_PING_URL=
